{
  "name": "@opt2-tealbrick/bridge",
  "version": "0.1.33",
  "private": true,
  "type": "module",
  "description": "Bridge core (deployed + relay forms). Never runs agents or calls models.",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
